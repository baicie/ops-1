# OpsWeave staging - service environment for the **node runtime only**.
# Host path: /srv/opsweave-staging/node.env   (root, mode 0600)
# Mounted into exactly one container: `node` (compose.yaml env_file).
#
# The node drives the host docker socket. It needs the kernel address and its
# own identity - nothing more. It must never be able to read the database
# password, the bootstrap admin password, or any *_SECRET value: a compromised
# node would otherwise escalate to database superuser or platform admin, which
# are privileges the node does not otherwise hold.
#
# FORBIDDEN in this file (enforced by scripts/deploy-staging.sh):
#   POSTGRES_*        DATABASE_URL        OPSWEAVE_BOOTSTRAP_ADMIN_*
#   OPSWEAVE_GHCR_TOKEN                   any key matching *SECRET*
#
# Already set by compose `environment:`, do not duplicate:
#   OPSWEAVE_KERNEL_URL OPSWEAVE_DOCKER_HOST OPSWEAVE_NODE_STATE_DIR
#   OPSWEAVE_NODE_DATA_BIND OPSWEAVE_NODE_DATA_ENDPOINT
#
# OPSWEAVE_NODE_HEARTBEAT_SECONDS lives in kernel.env; the node default (5s)
# matches it, so add it here only if the two values must differ.

# One-time enrolment token for the FIRST deploy only:
#   opsctl --url http://127.0.0.1:18080 node-token --label staging-node
# Consumed on redemption (nodes.rs:281-292). Once
# /var/lib/opsweave-staging/node/node-identity.json exists, leave this empty.
OPSWEAVE_ENROLLMENT_TOKEN=

OPSWEAVE_NODE_NAME=staging-node
OPSWEAVE_NODE_LABELS=role=node,zone=staging
OPSWEAVE_NODE_MAX_INSTANCES=4
OPSWEAVE_NODE_LEASE_SECONDS=30
