# OpsWeave staging - service environment for the **kernel** role only.
# Host path: /srv/opsweave-staging/kernel.env   (root, mode 0600)
# Mounted into exactly one container: `kernel` (compose.yaml env_file).
#
# Only keys the kernel process actually reads (apps/kernel/src/config.rs) and
# that compose does NOT already set in its own `environment:` block belong
# here. OPSWEAVE_BIND / DATA_DIR / WEB_DIST / PLUGIN_DB_HOST /
# PLUGIN_KERNEL_URL / BUILD_SHA / BUILD_TIME / ENVIRONMENT are interpolated by
# compose and must not be duplicated.
#
# This file legitimately holds credentials:
#   DATABASE_URL                      -> embeds the POSTGRES_PASSWORD value
#   OPSWEAVE_BOOTSTRAP_ADMIN_PASSWORD -> one-time first-boot admin (auth.rs:356-387)

# Port MUST stay 55432: the kernel derives the plugin DSN from this URL and only
# replaces the host with OPSWEAVE_PLUGIN_DB_HOST (storage.rs:208-221).
DATABASE_URL=postgres://opsweave:__CHANGE_ME_STRONG_RANDOM__@172.17.0.1:55432/opsweave?sslmode=disable

# Public origin for links and cookie security (plain HTTP => no Secure flag).
OPSWEAVE_PUBLIC_URL=http://__HOST_PUBLIC_IP__:18080

# One-time bootstrap admin: created ONLY when kernel.users is empty, never
# overwrites an existing admin. Leaving it here does not re-create or reset.
OPSWEAVE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
OPSWEAVE_BOOTSTRAP_ADMIN_PASSWORD=__CHANGE_ME_LONG_RANDOM__
# Quoted in the legacy single file because it was shell-sourced; env_file values
# are literal, so no quotes here.
OPSWEAVE_BOOTSTRAP_ADMIN_NAME=Platform Admin

# Required: the node data endpoint is plaintext http on loopback (nodes.rs:212-231).
OPSWEAVE_ALLOW_INSECURE_NODE_TRANSPORT=1
OPSWEAVE_ALLOWED_NODE_DATA_HOSTS=127.0.0.1,localhost,::1
# Hosts the kernel may pull plugin images from.
OPSWEAVE_PLUGIN_SOURCE_ALLOWED_HOSTS=127.0.0.1,172.17.0.1

OPSWEAVE_SESSION_HOURS=12
OPSWEAVE_NODE_HEARTBEAT_SECONDS=5
OPSWEAVE_NODE_STALE_SECONDS=25
OPSWEAVE_REQUEST_TIMEOUT_SECONDS=10
# Empty unless a reverse proxy sits in front (it would trust X-Forwarded-For).
OPSWEAVE_TRUSTED_PROXY_IPS=
OPSWEAVE_DEV_PUBLISHER_ID=trusted-team
# Ed25519 public key (hex) for the dev publisher; empty disables the seed.
OPSWEAVE_DEV_PUBLISHER_PUBLIC_KEY=
