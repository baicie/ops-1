# OpsWeave staging - service environment for **postgres only**.
# Host path: /srv/opsweave-staging/postgres.env   (root, mode 0600)
# Mounted into exactly one container: `postgres` (compose.yaml env_file).
#
# This is the ONLY file on the host that carries the database superuser
# password. Neither kernel.env nor node.env contains it: the kernel gets a
# DSN (DATABASE_URL, which embeds the same password) and the node gets nothing.
#
# Allowed keys here: POSTGRES_* only. PGDATA is set by compose `environment`
# and must not be duplicated. Anything else is a boundary violation - the
# deploy script refuses to start a release when this file grows an
# OPSWEAVE_* key (scripts/deploy-staging.sh: assert_service_env_boundary).
POSTGRES_DB=opsweave
POSTGRES_USER=opsweave
POSTGRES_PASSWORD=__CHANGE_ME_STRONG_RANDOM__
