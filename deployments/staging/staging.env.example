# OpsWeave staging runtime environment.
# Host path (bind-mounted / read by compose): /srv/opsweave-staging/staging.env
# Copy this file there, replace every __PLACEHOLDER__, then: chmod 600.
#
# Two kinds of variable live here:
#   (a) container environment  -> injected into every service through env_file
#   (b) shell interpolation    -> read by compose ${...} substitution; the deploy
#       script must `set -a; . staging.env; set +a` (or export them explicitly),
#       because compose ${VAR} does NOT read env_file.

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
# Bridge gateway. Must equal the output of:
#   docker network inspect bridge --format '{{(index .IPAM.Config 0).Gateway}}'
# Used by compose for the 55432/15001 gateway bindings and for the plugin
# report-back address. DATABASE_URL below must use the same address.
DOCKER_BRIDGE_IP=172.17.0.1

# GID owning /var/run/docker.sock on the host (usually root:docker).
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

POSTGRES_DB=opsweave
POSTGRES_USER=opsweave
POSTGRES_PASSWORD=__CHANGE_ME_STRONG_RANDOM__

# ---------------------------------------------------------------------------
# Kernel (role 1 of the image; also serves the Web Shell)
# ---------------------------------------------------------------------------
# Host networking: the Kernel listens on 18080 directly, no port mapping.
OPSWEAVE_BIND=0.0.0.0:18080
# Public origin used for links and cookie security (plain HTTP => no Secure).
OPSWEAVE_PUBLIC_URL=http://__HOST_PUBLIC_IP__:18080

# Port MUST be 55432: the Kernel derives the plugin DSN from this URL and only
# replaces the host with OPSWEAVE_PLUGIN_DB_HOST (storage.rs:208-221), keeping
# this port. Host networking reaches the bridge gateway, not a service name.
DATABASE_URL=postgres://opsweave:__CHANGE_ME_STRONG_RANDOM__@172.17.0.1:55432/opsweave?sslmode=disable

OPSWEAVE_DATA_DIR=/app/data
OPSWEAVE_WEB_DIST=/app/web

# One-time bootstrap admin (apps/kernel/src/auth.rs:356-387): created ONLY when
# kernel.users is empty, and it never overwrites an existing admin. Keep the
# password after first boot for reference or rotate it via the UI; leaving it
# here does not re-create or reset anything.
OPSWEAVE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
OPSWEAVE_BOOTSTRAP_ADMIN_PASSWORD=__CHANGE_ME_LONG_RANDOM__
# Quoted: the deploy script sources this file, so unquoted spaces break sourcing.
OPSWEAVE_BOOTSTRAP_ADMIN_NAME="Platform Admin"

# Required because the Node data endpoint is plaintext http on loopback.
OPSWEAVE_ALLOW_INSECURE_NODE_TRANSPORT=1
# The node role reports http://127.0.0.1:9101; 127.0.0.1 is both loopback and
# in this list, so the Kernel accepts it (apps/kernel/src/nodes.rs:212-231).
OPSWEAVE_ALLOWED_NODE_DATA_HOSTS=127.0.0.1,localhost,::1
# Hosts the Kernel may pull plugin images from (local registry + loopback).
OPSWEAVE_PLUGIN_SOURCE_ALLOWED_HOSTS=127.0.0.1,172.17.0.1

OPSWEAVE_SESSION_HOURS=12
OPSWEAVE_NODE_HEARTBEAT_SECONDS=5
OPSWEAVE_NODE_STALE_SECONDS=25
OPSWEAVE_REQUEST_TIMEOUT_SECONDS=10
# Leave empty unless a reverse proxy sits in front (it would trust X-Forwarded-For).
OPSWEAVE_TRUSTED_PROXY_IPS=
OPSWEAVE_DEV_PUBLISHER_ID=trusted-team
# Ed25519 public key (hex) for the dev publisher; empty disables the seed.
OPSWEAVE_DEV_PUBLISHER_PUBLIC_KEY=

# NOTE: OPSWEAVE_PLUGIN_DB_HOST and OPSWEAVE_PLUGIN_KERNEL_URL are set by
# compose.yaml from DOCKER_BRIDGE_IP. Do not duplicate them here.

# ---------------------------------------------------------------------------
# Node (role 2 of the image; host network + host docker socket)
# ---------------------------------------------------------------------------
OPSWEAVE_KERNEL_URL=http://127.0.0.1:18080
# One-time enrolment token for the FIRST deploy only:
#   opsctl --url http://127.0.0.1:18080 node-token --label staging-node
# It is consumed on redemption (nodes.rs:281-292). Once
# /var/lib/opsweave-staging/node/node-identity.json exists the node re-uses its
# stored identity, so leave this empty on later deploys.
OPSWEAVE_ENROLLMENT_TOKEN=
OPSWEAVE_NODE_NAME=staging-node
OPSWEAVE_NODE_LABELS=role=node,zone=staging
# Loopback-only data plane: accepted by the Kernel whitelist above.
OPSWEAVE_NODE_DATA_BIND=127.0.0.1:9101
OPSWEAVE_NODE_DATA_ENDPOINT=http://127.0.0.1:9101
OPSWEAVE_NODE_STATE_DIR=/app/node-state
OPSWEAVE_DOCKER_HOST=unix:///var/run/docker.sock
OPSWEAVE_NODE_MAX_INSTANCES=4
OPSWEAVE_NODE_LEASE_SECONDS=30

# ---------------------------------------------------------------------------
# Build identity (shell interpolation by the deploy script)
# Not container config: compose injects these into the kernel container.
# ---------------------------------------------------------------------------
OPSWEAVE_BUILD_SHA=0000000000000000000000000000000000000000
OPSWEAVE_BUILD_TIME=1970-01-01T00:00:00Z
