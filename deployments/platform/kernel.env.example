# OpsWeave Platform — Kernel environment.
#
# Generated by `scripts/platform_up.sh install`. Mode 0600, owned by root.
# Mounted into exactly one container: `kernel`.
#
# OPSWEAVE_BIND / DATA_DIR / WEB_DIST / PLUGIN_DB_HOST / PLUGIN_KERNEL_URL /
# BUILD_SHA / BUILD_TIME / ENVIRONMENT are set by compose and must not be
# duplicated here.

# The port MUST match OPSWEAVE_PG_PORT in platform.env: the Kernel derives the
# plugin DSN from this URL and only replaces the host.
DATABASE_URL=postgres://opsweave:__DB_PASSWORD__@172.17.0.1:55432/opsweave?sslmode=disable

# Public origin, used for cookie security. Set OPSWEAVE_PUBLIC_URL to your real
# origin (https://...) once a TLS proxy is in front; plain http here means the
# session cookie is not marked Secure, and the install script says so.
OPSWEAVE_PUBLIC_URL=http://__HOST__:18080

# One-time bootstrap administrator. Created ONLY when kernel.users has no human
# account, and it never overwrites an existing one. After first boot this value
# is inert; keep it for recovery or remove it.
#
# There is NO default. The install script refuses to start without a supplied
# password and never prints one into a log.
OPSWEAVE_BOOTSTRAP_ADMIN_EMAIL=__ADMIN_EMAIL__
OPSWEAVE_BOOTSTRAP_ADMIN_PASSWORD=__ADMIN_PASSWORD__
OPSWEAVE_BOOTSTRAP_ADMIN_NAME=Platform Admin

# The node data endpoint is plaintext http on loopback in this single-host
# profile, so the Kernel must be told that is intentional.
OPSWEAVE_ALLOW_INSECURE_NODE_TRANSPORT=1
OPSWEAVE_ALLOWED_NODE_DATA_HOSTS=127.0.0.1,localhost,::1
# Hosts the Kernel may pull plugin images from: the local registry only.
OPSWEAVE_PLUGIN_SOURCE_ALLOWED_HOSTS=127.0.0.1,172.17.0.1

OPSWEAVE_SESSION_HOURS=12
OPSWEAVE_NODE_HEARTBEAT_SECONDS=5
OPSWEAVE_NODE_STALE_SECONDS=25
OPSWEAVE_REQUEST_TIMEOUT_SECONDS=10
# Empty unless a reverse proxy sits in front (it would trust X-Forwarded-For).
OPSWEAVE_TRUSTED_PROXY_IPS=

# Publisher trust. Empty on purpose: a fresh platform trusts no publisher, so no
# plugin can be installed until an administrator adds one. Install one with
# `opsctl publishers add` or the console's Governance page.
OPSWEAVE_DEV_PUBLISHER_ID=
OPSWEAVE_DEV_PUBLISHER_PUBLIC_KEY=
