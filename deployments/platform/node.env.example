# OpsWeave Platform — Node Runtime environment.
#
# Generated by `scripts/platform_up.sh install`. Mode 0600, owned by root.
# Mounted into exactly one container: `node`.
#
# This file must never contain a database URL, a bootstrap password, or any
# secret. The install script refuses to start if it does.

# One-time enrolment token. The install script fills this from
# `opsctl node-token` on the first run and clears it afterwards; once
# node/node-identity.json exists the node reuses that identity.
OPSWEAVE_ENROLLMENT_TOKEN=

OPSWEAVE_NODE_NAME=platform-node
OPSWEAVE_NODE_LABELS=role=node
OPSWEAVE_NODE_MAX_INSTANCES=4
OPSWEAVE_NODE_LEASE_SECONDS=30
