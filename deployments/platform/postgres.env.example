# OpsWeave Platform — PostgreSQL environment.
#
# Generated by `scripts/platform_up.sh install` with a random password, or written
# by hand from this template. Mode 0600, owned by root.
#
# This is the ONLY file on the host carrying the database superuser password.
# `kernel.env` gets a DSN that embeds the same value; `node.env` gets neither.

POSTGRES_DB=opsweave
POSTGRES_USER=opsweave
POSTGRES_PASSWORD=__CHANGE_ME_STRONG_RANDOM__
