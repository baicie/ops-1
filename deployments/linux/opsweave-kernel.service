[Unit]
Description=OpsWeave Kernel (Platform Foundation)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=opsweave
Group=opsweave
EnvironmentFile=/etc/opsweave/kernel.env
ExecStart=/opt/opsweave/bin/opsweave-kernel
Restart=on-failure
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/opsweave /var/log/opsweave
StandardOutput=append:/var/log/opsweave/kernel.log
StandardError=append:/var/log/opsweave/kernel.log

[Install]
WantedBy=multi-user.target
