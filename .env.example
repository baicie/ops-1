# Kernel
OPSWEAVE_BIND=127.0.0.1:18181
OPSWEAVE_PUBLIC_URL=https://opsweave.internal.example
DATABASE_URL=postgres://opsweave:CHANGE_ME@127.0.0.1:5432/opsweave?sslmode=require
OPSWEAVE_DATA_DIR=/var/lib/opsweave
OPSWEAVE_WEB_DIST=/opt/opsweave/web
OPSWEAVE_SESSION_HOURS=12
OPSWEAVE_NODE_HEARTBEAT_SECONDS=5
OPSWEAVE_NODE_STALE_SECONDS=25
OPSWEAVE_REQUEST_TIMEOUT_SECONDS=10
# Remote plaintext HTTP is rejected by default. Loopback development endpoints are exempt.
OPSWEAVE_ALLOW_INSECURE_NODE_TRANSPORT=0
OPSWEAVE_ALLOWED_NODE_DATA_HOSTS=node-a.internal.example,node-b.internal.example
# Only list the ingress/proxy addresses that are allowed to supply X-Forwarded-For.
OPSWEAVE_TRUSTED_PROXY_IPS=127.0.0.1
# One-time bootstrap admin; remove after first boot or rotate immediately.
OPSWEAVE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
OPSWEAVE_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM
OPSWEAVE_BOOTSTRAP_ADMIN_NAME=Platform Admin
# Development-only publisher seed. In production use POST /api/v1/publishers
# from an admin session after offline key approval.
OPSWEAVE_DEV_PUBLISHER_ID=trusted-team
OPSWEAVE_DEV_PUBLISHER_PUBLIC_KEY=64_HEX_ED25519_PUBLIC_KEY

# Node
OPSWEAVE_KERNEL_URL=https://opsweave.internal.example
OPSWEAVE_ENROLLMENT_TOKEN=ONE_TIME_TOKEN_FROM_ADMIN
OPSWEAVE_NODE_NAME=node-a
OPSWEAVE_NODE_LABELS=role=node,zone=lab-a
OPSWEAVE_NODE_DATA_BIND=127.0.0.1:9101
# Reference Node serves HTTP on a private interface. Production MUST put an authenticated
# TLS/mTLS terminator or tunnel in front of it; do not expose this listener directly.
OPSWEAVE_NODE_DATA_ENDPOINT=https://node-a.internal.example:9101
OPSWEAVE_NODE_LEASE_SECONDS=30
OPSWEAVE_NODE_STATE_DIR=/var/lib/opsweave-node
OPSWEAVE_DOCKER_HOST=unix:///run/user/1000/docker.sock

# Artifact registry (used by build/publish tooling, not the Kernel)
OPSWEAVE_REGISTRY=registry.internal.example
