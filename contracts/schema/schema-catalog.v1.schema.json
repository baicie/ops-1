{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsweave.dev/schema/schema-catalog.v1.schema.json",
  "title": "OpsWeave Trusted Schema Catalog Snapshot",
  "type": "object",
  "required": ["catalogVersion", "datasets"],
  "additionalProperties": false,
  "properties": {
    "catalogVersion": { "const": "schema-catalog.opsweave.io/v1" },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["datasetId", "latestPublishedRevision", "revisions"],
        "additionalProperties": false,
        "properties": {
          "datasetId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "name": { "type": "string" },
          "latestPublishedRevision": { "type": "integer", "minimum": 1 },
          "revisions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["schemaRevision", "status", "digest", "fields"],
              "additionalProperties": false,
              "properties": {
                "schemaRevision": { "type": "integer", "minimum": 1 },
                "status": { "enum": ["DRAFT", "PUBLISHED"] },
                "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "type", "nullable"],
                    "additionalProperties": false,
                    "properties": {
                      "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
                      "type": { "enum": ["string", "integer", "number", "boolean", "timestamp", "json"] },
                      "nullable": { "type": "boolean" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
