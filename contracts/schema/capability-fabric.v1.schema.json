{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.opsweave.dev/capability-fabric.v1.schema.json",
  "title": "OpsWeave Capability Fabric v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capability"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "capability": { "$ref": "#/$defs/CapabilityDescriptor" },
    "grant": { "$ref": "#/$defs/CapabilityGrant" },
    "caller": { "$ref": "#/$defs/CallerContext" }
  },
  "$defs": {
    "CapabilityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "major"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9.]+$" },
        "major": { "type": "integer", "minimum": 1 }
      }
    },
    "CapabilityDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "major", "providerPluginId", "providerVersion",
        "activationRevision", "apiDigest", "executionMode", "status"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9.]+$" },
        "major": { "type": "integer", "minimum": 1 },
        "providerPluginId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,100}$" },
        "providerVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
        "activationRevision": { "type": "integer", "minimum": 1 },
        "apiDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "permissions": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9.:/-]{2,100}$" }
        },
        "executionMode": { "enum": ["sync"] },
        "status": { "enum": ["AVAILABLE", "DEGRADED", "UNAVAILABLE"] }
      }
    },
    "CapabilityGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grantId", "name", "major", "consumerPluginId", "scope",
        "state", "createdAt"
      ],
      "properties": {
        "grantId": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9.]+$" },
        "major": { "type": "integer", "minimum": 1 },
        "consumerPluginId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,100}$" },
        "scope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9.:/-]{2,100}$" }
        },
        "state": { "enum": ["ACTIVE", "REVOKED", "EXPIRED"] },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "CallerContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workloadId", "pluginId", "capability", "audience", "scope", "expiresAt", "signature"],
      "description": "Fields are claims in a short-lived, Kernel-signed workload token. Never accept these as self-asserted headers.",
      "properties": {
        "workloadId": { "type": "string", "format": "uuid" },
        "pluginId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,100}$" },
        "capability": { "$ref": "#/$defs/CapabilityRef" },
        "audience": { "type": "string", "minLength": 3 },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "expiresAt": { "type": "string", "format": "date-time" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{32,}$" }
      }
    }
  }
}
