{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.opsweave.dev/frontend-asset-index.v1.schema.json",
  "title": "Frontend Asset Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "assets"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^frontend/[A-Za-z0-9_./-]+$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
