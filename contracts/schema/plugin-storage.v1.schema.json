{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.opsweave.dev/plugin-storage.v1.schema.json",
  "title": "OpsWeave Plugin Storage Ownership v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pluginId", "schemaName", "migrationPlanDigest", "retention"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "pluginId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,100}$" },
    "schemaName": { "type": "string", "pattern": "^plugin_[a-z0-9_]{3,48}$" },
    "migrationPlanDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onDisable", "onUninstall"],
      "properties": {
        "onDisable": { "const": "RETAIN" },
        "onUninstall": { "enum": ["RETAIN", "PURGE_REQUIRES_BACKUP"] }
      }
    },
    "migrations": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["migrationId", "phase", "checksum", "sql"],
        "properties": {
          "migrationId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,64}$" },
          "phase": { "enum": ["EXPAND", "MIGRATE", "CONTRACT"] },
          "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "sql": { "type": "string", "minLength": 1, "maxLength": 65536 }
        }
      }
    }
  }
}
