{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsweave.dev/schema/durable-job.v1.schema.json",
  "title": "OpsWeave Durable Job v1",
  "type": "object",
  "required": ["schemaVersion", "jobId", "pipelineId", "pipelineRevision", "idempotencyKey", "status", "input", "attempts", "maxAttempts", "createdAt", "updatedAt"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "job.opsweave.io/v1" },
    "jobId": { "type": "string", "format": "uuid" },
    "pipelineId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "pipelineRevision": { "type": "integer", "minimum": 1 },
    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128 },
    "status": { "enum": ["QUEUED", "CLAIMED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED"] },
    "input": { "type": "object", "maxProperties": 32 },
    "attempts": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/JobAttempt" } },
    "lease": { "oneOf": [{ "$ref": "#/$defs/JobLease" }, { "type": "null" }] },
    "checkpoint": { "oneOf": [{ "$ref": "#/$defs/Checkpoint" }, { "type": "null" }] },
    "result": { "oneOf": [{ "$ref": "#/$defs/JobResult" }, { "type": "null" }] },
    "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 8 },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "WorkerIdentity": {
      "type": "object",
      "required": ["workerId", "nodeId", "instanceId", "bootId"],
      "additionalProperties": false,
      "properties": {
        "workerId": { "type": "string", "pattern": "^[a-zA-Z0-9._:-]{3,128}$" },
        "nodeId": { "type": "string", "format": "uuid" },
        "instanceId": { "type": "string", "format": "uuid" },
        "bootId": { "type": "string", "format": "uuid" },
        "version": { "type": "string" }
      }
    },
    "FencingToken": {
      "type": "object",
      "required": ["tokenId", "jobId", "leaseId", "sequence", "issuedAt", "expiresAt"],
      "additionalProperties": false,
      "properties": {
        "tokenId": { "type": "string", "format": "uuid" },
        "jobId": { "type": "string", "format": "uuid" },
        "leaseId": { "type": "string", "format": "uuid" },
        "sequence": { "type": "integer", "minimum": 1 },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "signature": { "type": "string" }
      }
    },
    "JobLease": {
      "type": "object",
      "required": ["leaseId", "jobId", "worker", "fencingToken", "status", "acquiredAt", "heartbeatAt", "expiresAt"],
      "additionalProperties": false,
      "properties": {
        "leaseId": { "type": "string", "format": "uuid" },
        "jobId": { "type": "string", "format": "uuid" },
        "worker": { "$ref": "#/$defs/WorkerIdentity" },
        "fencingToken": { "$ref": "#/$defs/FencingToken" },
        "status": { "enum": ["ACTIVE", "EXPIRED", "REVOKED", "RELEASED"] },
        "acquiredAt": { "type": "string", "format": "date-time" },
        "heartbeatAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "JobAttempt": {
      "type": "object",
      "required": ["attemptNumber", "worker", "leaseId", "fencingSequence", "status", "startedAt"],
      "additionalProperties": false,
      "properties": {
        "attemptNumber": { "type": "integer", "minimum": 1, "maximum": 8 },
        "worker": { "$ref": "#/$defs/WorkerIdentity" },
        "leaseId": { "type": "string", "format": "uuid" },
        "fencingSequence": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["CLAIMED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED", "LOST"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": ["string", "null"], "format": "date-time" },
        "errorCode": { "type": ["string", "null"] }
      }
    },
    "Checkpoint": {
      "type": "object",
      "required": ["checkpointId", "jobId", "attemptNumber", "sequence", "fencingSequence", "stateDigest", "createdAt"],
      "additionalProperties": false,
      "properties": {
        "checkpointId": { "type": "string", "format": "uuid" },
        "jobId": { "type": "string", "format": "uuid" },
        "attemptNumber": { "type": "integer", "minimum": 1 },
        "sequence": { "type": "integer", "minimum": 1 },
        "fencingSequence": { "type": "integer", "minimum": 1 },
        "inputCursor": { "type": "string", "maxLength": 512 },
        "stateDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "JobResult": {
      "type": "object",
      "required": ["status", "fencingSequence", "completedAt"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["SUCCEEDED", "FAILED", "CANCELLED"] },
        "fencingSequence": { "type": "integer", "minimum": 1 },
        "output": { "type": "object", "maxProperties": 32 },
        "errorCode": { "type": ["string", "null"] },
        "errorMessage": { "type": ["string", "null"], "maxLength": 1024 },
        "checkpointId": { "type": ["string", "null"], "format": "uuid" },
        "resultDigest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    },
    "JobStateTransition": {
      "type": "object",
      "required": ["from", "to", "reason"],
      "additionalProperties": false,
      "properties": {
        "from": { "enum": ["QUEUED", "CLAIMED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED"] },
        "to": { "enum": ["QUEUED", "CLAIMED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fencingSequence": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
